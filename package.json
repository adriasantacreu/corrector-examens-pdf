{
  "name": "prova-app-correccio-pc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "tsc -b && vitest run",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots=all",
    "verify": "npm run test:fast && npm run e2e",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "konva": "^10.2.0",
    "lucide-react": "^0.577.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
